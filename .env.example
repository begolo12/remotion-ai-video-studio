# ============================================================
# Remotion AI Video Studio - environment variables
# Salin ke .env.local untuk development. JANGAN pernah commit
# file .env.local atau menaruh API key di repository.
# ============================================================

# --- Neon Postgres (Vercel Marketplace, region Singapore) ---
# Pooled connection: dipakai aplikasi saat runtime.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection: HANYA untuk drizzle-kit migrate. Tanpa suffix -pooler.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- InferHub (OpenAI-compatible) ---
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
INFERHUB_MODEL=cx/gpt-6.2-sol
# Kosongkan bila tidak ingin fallback otomatis.
INFERHUB_FALLBACK_MODEL=
# WAJIB diisi di Vercel Environment Variables, jangan di sini.
INFERHUB_API_KEY=

# --- Auth ---
# Minimal 32 karakter acak. Generate: openssl rand -base64 48
AUTH_SECRET=

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=

# --- Cron ---
# Secret untuk melindungi /api/cron/*. Nilai acak yang sama dengan AUTH_SECRET boleh,
# tetapi lebih baik memakai nilai terpisah.
CRON_SECRET=

# --- Render ---
# URL publik deployment yang berisi bundle Remotion. Contoh:
# https://remotion-ai-video-studio.vercel.app
RENDER_SERVE_URL=

# --- Opsional ---
# Region Vercel Sandbox untuk render. Default mengikuti project.
# VERCEL_REGION=sin1

# --- Legacy (masih dipakai engine lama, boleh dikosongkan) ---
# NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
# NINE_ROUTER_API_KEY=
# NINE_ROUTER_MODEL=d/standar
# NINE_ROUTER_FALLBACK_MODEL=
